{
  "name": "proof-core",
  "defaults": {"longEdge": 1536, "paths": ["export"], "tile": 300},
  "jobs": [
    {"id": "exposure", "photos": ["6929", "5812", "chart:greyRamp"],
     "paths": ["export", "settled", "draft"],
     "sweep": {"path": "develop.tone.exposure", "values": [-2, -1, -0.5, 0.5, 1, 2], "neutral": 0}},
    {"id": "exposure-linear", "photo": "chart:greyRamp",
     "description": "Exposure on the Linear render preset: patch Y ratio should be 2^EV",
     "recipe": {"look.render.preset": "Linear"},
     "sweep": {"path": "develop.tone.exposure", "values": [-1, 1, 2], "neutral": 0}},
    {"id": "contrast", "photos": ["6929", "5812", "chart:greyRamp"],
     "sweep": {"path": "develop.tone.contrast", "values": [-100, -50, 50, 100], "neutral": 0}},
    {"id": "highlights", "photos": ["6929", "5812", "chart:greyRamp"],
     "sweep": {"path": "develop.tone.highlights", "values": [-100, -50, 50, 100], "neutral": 0}},
    {"id": "shadows", "photos": ["6929", "5812", "chart:greyRamp"],
     "sweep": {"path": "develop.tone.shadows", "values": [-100, -50, 50, 100], "neutral": 0}},
    {"id": "temperature", "photos": ["6929", "5812", "chart:colorChecker"],
     "sweep": {"path": "develop.raw.temp", "label": "temp", "values": [2500, 3500, 4500, 6500, 8000, 12000]}},
    {"id": "saturation", "photos": ["6929", "5812", "chart:hueRing", "chart:skin"],
     "sweep": {"path": "develop.color.saturation", "values": [-100, -50, 50, 100], "neutral": 0}},
    {"id": "film-grain", "photos": ["6929", "chart:flatGrey"],
     "grid": {"x": {"path": "look.filmLab.grain.amount", "label": "grain", "values": [0, 40, 80]},
              "y": {"path": "look.filmLab.stock", "label": "stock",
                    "values": ["lumen/portra400", "lumen/trix400", "lumen/velvia50"]}}},
    {"id": "film-portra-grain", "photos": ["6929", "5812", "chart:colorChecker"],
     "recipe": {"look.filmLab.stock": "lumen/portra400"},
     "sweep": {"path": "look.filmLab.grain.amount", "label": "grain", "values": [20, 40, 70, 100], "neutral": 0}},
    {"id": "sharpen-crop", "photo": "6929", "longEdge": 1200,
     "description": "Sharpening near 1:1 on a centre crop (25% of the frame, exported at 1200 px)",
     "recipe": {"develop.geometry.crop": {"x": 0.375, "y": 0.375, "w": 0.25, "h": 0.25}},
     "sweep": {"path": "develop.detail.sharpen.amount", "values": [40, 80, 150], "neutral": 0}},
    {"id": "sharpen", "photos": ["5812", "chart:detail"],
     "sweep": {"path": "develop.detail.sharpen.amount", "values": [40, 80, 150], "neutral": 0}}
  ]
}
