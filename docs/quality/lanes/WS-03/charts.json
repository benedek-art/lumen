 "_meta": {
  "coordinates": "pixel rects [x, y, w, h] in corpus/lfi/<name>.lfi as delivered by scripts/proof/fetch_corpus.sh at --long-edge 2400 (upright, top-left origin)",
  "method": "chart neutral = mean of the per-patch normalised linear RGB of the mid-grey patches (`midGreys`), solved for the Lumen (Kelvin, tint) whose WhiteBalanceEngine adaptation from the sidecar as-shot pair makes it R=G=B (same objective as WhiteBalanceEngine.neutralizing, Python port in the WS-03 audit, cross-checked against lumen-render). adobeEquivalent assumes the decode is a CAT16 adaptation of the as-shot illuminant to D65 (approximation).",
  "residual_definition": "OKLab chroma of the mid-grey mean scaled to Y~0.18, scene-linear Rec.2020; deltaE00 vs neutral of same Y"
 },
