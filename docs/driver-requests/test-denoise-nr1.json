{
 "suite": "",
 "scenarios": [
  {
   "name": "nr-zoom-threshold",
   "description": "Where does the viewer start showing Classic NR? Luminance+Colour 100 vs ISO default, compared on screen at fit, 25%, 50%, 75% and 1:1 on the 33 MP A7 IV ARW.",
   "fixture": "raw",
   "timeoutSeconds": 900,
   "steps": [
    {
     "do": "open",
     "photo": "A7IV",
     "workspace": "develop",
     "timeout": 90
    },
    {
     "do": "scrollTo",
     "target": {
      "text": "Noise Reduction",
      "within": "develop.column"
     }
    },
    {
     "do": "click",
     "target": {
      "text": "Noise Reduction",
      "within": "develop.column"
     }
    },
    {
     "do": "wait",
     "seconds": 1
    },
    {
     "do": "shot",
     "name": "panel-classic"
    },
    {
     "do": "state",
     "name": "panel-classic",
     "texts": true
    },
    {
     "do": "scrollTo",
     "target": "slider/Luminance#track"
    },
    {
     "do": "drag",
     "id": "luma",
     "target": "slider/Luminance#track",
     "from": [
      0.3,
      0.5
     ],
     "to": [
      1.0,
      0.5
     ],
     "duration": 1.0,
     "settle": 30,
     "watch": "develop.denoise.classic.luma"
    },
    {
     "do": "drag",
     "id": "chroma",
     "target": "slider/Colour#track",
     "from": [
      0.3,
      0.5
     ],
     "to": [
      1.0,
      0.5
     ],
     "duration": 1.0,
     "settle": 30,
     "watch": "develop.denoise.classic.chroma"
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "panel-strong"
    },
    {
     "do": "state",
     "name": "strong"
    },
    {
     "do": "shot",
     "name": "fit-strong"
    },
    {
     "do": "key",
     "key": "z",
     "modifiers": [
      "cmd"
     ],
     "count": 2,
     "interval": 0.3
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "fit-default"
    },
    {
     "do": "state",
     "name": "fit-default"
    },
    {
     "do": "compare",
     "name": "fit",
     "a": "fit-strong",
     "b": "fit-default"
    },
    {
     "do": "key",
     "key": "z",
     "modifiers": [
      "cmd",
      "shift"
     ],
     "count": 2,
     "interval": 0.3
    },
    {
     "do": "direct",
     "call": "setZoom",
     "value": 0.25
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "z25-strong"
    },
    {
     "do": "state",
     "name": "z25"
    },
    {
     "do": "key",
     "key": "z",
     "modifiers": [
      "cmd"
     ],
     "count": 2,
     "interval": 0.3
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "z25-default"
    },
    {
     "do": "compare",
     "name": "z25",
     "a": "z25-strong",
     "b": "z25-default"
    },
    {
     "do": "key",
     "key": "z",
     "modifiers": [
      "cmd",
      "shift"
     ],
     "count": 2,
     "interval": 0.3
    },
    {
     "do": "direct",
     "call": "setZoom",
     "value": 0.5
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "z50-strong"
    },
    {
     "do": "state",
     "name": "z50"
    },
    {
     "do": "key",
     "key": "z",
     "modifiers": [
      "cmd"
     ],
     "count": 2,
     "interval": 0.3
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "z50-default"
    },
    {
     "do": "compare",
     "name": "z50",
     "a": "z50-strong",
     "b": "z50-default"
    },
    {
     "do": "key",
     "key": "z",
     "modifiers": [
      "cmd",
      "shift"
     ],
     "count": 2,
     "interval": 0.3
    },
    {
     "do": "direct",
     "call": "setZoom",
     "value": 1.0
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "z100-strong"
    },
    {
     "do": "state",
     "name": "z100"
    },
    {
     "do": "key",
     "key": "z",
     "modifiers": [
      "cmd"
     ],
     "count": 2,
     "interval": 0.3
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "z100-default"
    },
    {
     "do": "compare",
     "name": "z100",
     "a": "z100-strong",
     "b": "z100-default"
    },
    {
     "do": "state",
     "name": "end"
    }
   ]
  },
  {
   "name": "nr-ai-amount-drag",
   "description": "AI (stand-in) mode: panel, and the cost of dragging its Amount (part of the RAW decode key) against dragging Classic Luminance, on the 33 MP A7 IV ARW at fit.",
   "fixture": "raw",
   "timeoutSeconds": 900,
   "steps": [
    {
     "do": "open",
     "photo": "A7IV",
     "workspace": "develop",
     "timeout": 90
    },
    {
     "do": "scrollTo",
     "target": {
      "text": "Noise Reduction",
      "within": "develop.column"
     }
    },
    {
     "do": "click",
     "target": {
      "text": "Noise Reduction",
      "within": "develop.column"
     }
    },
    {
     "do": "wait",
     "seconds": 1
    },
    {
     "do": "scrollTo",
     "target": "slider/Luminance#track"
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "drag",
     "id": "luma-drag",
     "target": "slider/Luminance#track",
     "from": [
      0.2,
      0.5
     ],
     "to": [
      0.8,
      0.5
     ],
     "duration": 1.5,
     "hz": 60,
     "settle": 30,
     "film": 30,
     "watch": "develop.denoise.classic.luma"
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "click",
     "target": {
      "text": "AI (stand-in)",
      "within": "develop.column"
     }
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "panel-ai"
    },
    {
     "do": "state",
     "name": "ai",
     "texts": true
    },
    {
     "do": "expect",
     "that": "recipe.develop.denoise.mode",
     "eq": "ai",
     "note": "clicking AI (stand-in) selects AI"
    },
    {
     "do": "drag",
     "id": "ai-drag",
     "target": {
      "anchor": "slider/Amount#track",
      "index": 2,
      "within": "develop.column"
     },
     "from": [
      0.5,
      0.5
     ],
     "to": [
      0.95,
      0.5
     ],
     "duration": 1.5,
     "hz": 60,
     "settle": 60,
     "film": 30,
     "watch": "develop.denoise.amount"
    },
    {
     "do": "waitSettled",
     "timeout": 60
    },
    {
     "do": "state",
     "name": "ai-after"
    },
    {
     "do": "click",
     "target": {
      "text": "Classic",
      "within": "develop.column"
     }
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "state",
     "name": "back-classic"
    },
    {
     "do": "shot",
     "name": "panel-back-classic"
    },
    {
     "do": "click",
     "target": {
      "text": "Off",
      "within": "develop.column",
      "index": 0
     }
    },
    {
     "do": "waitSettled"
    },
    {
     "do": "shot",
     "name": "panel-off"
    },
    {
     "do": "state",
     "name": "off"
    }
   ]
  }
 ],
