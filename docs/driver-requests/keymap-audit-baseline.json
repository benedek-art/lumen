   "fixture": "fiducial",
   "steps": [
    {
     "do": "open",
     "photo": "fiducial.png",
     "workspace": "develop"
    },
    {
     "do": "state",
     "name": "menus-before"
    },
    {
     "do": "key",
     "key": "c",
     "modifiers": [
      "cmd",
      "option"
     ]
    },
