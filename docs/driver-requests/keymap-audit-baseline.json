     "that": "menu.Edit > Paste Settings Without Masks.enabled",
     "eq": true,
     "note": "after Copy Settings, shift-cmd-V is enabled"
    },
    {
     "do": "key",
     "key": "s",
     "modifiers": [
      "cmd",
      "option"
     ]
    },
    {
