{
 "suite": "",
 "scenarios": [
  {
   "name": "keymap-undo-while-typing",
   "description": "Cmd-Z pressed while the palette's text field has the keyboard must not undo the photograph's last edit (the Edit menu replaces AppKit's Undo item for every context). Also: Escape closes the palette.",
   "fixture": "fiducial",
   "steps": [
    {
     "do": "open",
     "photo": "fiducial.png",
     "workspace": "develop"
    },
    {
     "do": "scrollTo",
     "target": "slider/Exposure#track"
    },
    {
     "do": "drag",
     "id": "exposure",
     "target": "slider/Exposure#track",
     "from": [
      0.5,
      0.5
     ],
     "to": [
      0.7,
      0.5
     ],
     "duration": 0.6,
     "settle": 10
    },
    {
     "do": "expect",
     "that": "recipe.develop.tone.exposure",
     "gt": 0.1,
     "note": "setup: an edit exists"
    },
    {
     "do": "wait",
     "seconds": 1.5
    },
    {
     "do": "key",
     "key": "k",
     "modifiers": [
      "cmd"
     ]
    },
    {
     "do": "waitFor",
     "that": "app.showControlPalette",
     "eq": true,
     "timeout": 5
    },
    {
     "do": "wait",
     "seconds": 0.5
    },
    {
     "do": "type",
     "text": "abc"
    },
    {
     "do": "key",
     "key": "z",
     "modifiers": [
      "cmd"
     ]
    },
    {
     "do": "wait",
     "seconds": 0.6
    },
    {
     "do": "state",
     "name": "after-cmd-z"
    },
    {
     "do": "expect",
     "that": "recipe.develop.tone.exposure",
     "gt": 0.1,
     "note": "Cmd-Z in a text field must not undo the photo's Exposure edit"
    },
    {
     "do": "key",
     "key": "escape"
    },
    {
     "do": "wait",
     "seconds": 0.4
    },
    {
     "do": "expect",
     "that": "app.showControlPalette",
     "eq": false,
     "note": "Escape closes the palette"
    }
   ]
  },
  {
   "name": "keymap-printer-lights",
   "description": "The printer-light keys: bare , . step the master while the rows are on screen; the modifier variants step one trim each; and a '.' typed into a text field must stay in the text field.",
   "fixture": "fiducial",
   "steps": [
    {
     "do": "open",
     "photo": "fiducial.png",
     "workspace": "grade"
    },
    {
     "do": "key",
     "key": "k",
     "modifiers": [
      "cmd"
     ]
    },
    {
     "do": "waitFor",
     "that": "app.showControlPalette",
     "eq": true,
     "timeout": 5
    },
    {
     "do": "wait",
     "seconds": 0.4
    },
    {
     "do": "type",
     "text": "printer"
    },
    {
     "do": "key",
     "key": "return"
    },
    {
     "do": "wait",
     "seconds": 0.8
    },
    {
     "do": "state",
     "name": "grading-open"
    },
    {
     "do": "shot",
     "name": "grading-open"
    },
    {
     "do": "key",
     "key": "."
    },
    {
     "do": "wait",
     "seconds": 0.4
    },
    {
     "do": "expect",
     "that": "recipe.look.printerLights.master",
     "eq": 1,
     "note": "bare . steps the master up one point"
    },
    {
     "do": "key",
     "key": ".",
     "modifiers": [
      "shift"
     ]
    },
    {
     "do": "wait",
     "seconds": 0.4
    },
    {
     "do": "expect",
     "that": "recipe.look.printerLights.b",
     "eq": 1,
     "note": "shift-. steps the blue trim (KeyGrammar, the row's tooltip)"
    },
    {
     "do": "key",
     "key": ".",
     "modifiers": [
      "ctrl"
     ]
    },
    {
     "do": "wait",
     "seconds": 0.4
    },
    {
     "do": "expect",
     "that": "recipe.look.printerLights.r",
     "eq": 1,
     "note": "ctrl-. steps the red trim"
    },
    {
     "do": "key",
     "key": ".",
     "modifiers": [
      "option"
     ]
    },
    {
     "do": "wait",
     "seconds": 0.4
    },
    {
     "do": "expect",
     "that": "recipe.look.printerLights.g",
     "eq": 1,
     "note": "option-. steps the green trim"
    },
    {
     "do": "state",
     "name": "after-steps"
    },
    {
     "do": "key",
     "key": "k",
     "modifiers": [
      "cmd"
     ]
    },
    {
     "do": "waitFor",
     "that": "app.showControlPalette",
     "eq": true,
     "timeout": 5
    },
    {
     "do": "wait",
     "seconds": 0.4
    },
    {
     "do": "type",
     "text": "a.b.c"
    },
    {
     "do": "wait",
     "seconds": 0.4
    },
    {
     "do": "state",
     "name": "typed-dots"
    },
    {
     "do": "shot",
     "name": "typed-dots"
    },
    {
     "do": "expect",
     "that": "recipe.look.printerLights.master",
     "le": 1,
     "note": "a '.' typed into the palette field must not step the master printer light"
    },
    {
     "do": "key",
     "key": "escape"
    }
   ]
  },
  {
   "name": "keymap-clear-filter-lights-out",
   "description": "Cmd-backslash clears the filter. It is attached to the filter bar's Clear button, which Lights Out 'out' removes from the hierarchy.",
   "fixture": "fiducial",
   "steps": [
    {
     "do": "open",
     "photo": "fiducial.png",
     "workspace": "develop"
    },
    {
     "do": "key",
     "key": "p"
    },
    {
     "do": "wait",
     "seconds": 0.3
    },
    {
     "do": "key",
     "key": "p",
     "modifiers": [
      "cmd",
      "option"
     ]
    },
    {
     "do": "wait",
     "seconds": 0.5
    },
    {
     "do": "expect",
     "that": "app.filter.flags.count",
     "eq": 1,
     "note": "setup: picks-only filter is on"
    },
    {
     "do": "key",
     "key": "\\",
     "modifiers": [
      "cmd"
     ]
    },
    {
     "do": "wait",
     "seconds": 0.5
    },
    {
     "do": "expect",
     "that": "app.filter.flags.count",
     "eq": 0,
     "note": "control: with the filter bar up, Cmd-backslash clears"
    },
    {
     "do": "key",
     "key": "p",
     "modifiers": [
      "cmd",
      "option"
     ]
    },
    {
     "do": "wait",
     "seconds": 0.5
    },
    {
     "do": "key",
     "key": "l"
    },
    {
     "do": "key",
     "key": "l"
    },
    {
     "do": "wait",
     "seconds": 0.5
    },
    {
     "do": "expect",
     "that": "app.lightsOut",
     "eq": "out"
    },
    {
     "do": "expect",
     "that": "app.filter.flags.count",
     "eq": 1,
     "note": "setup: filter on again at Lights Out"
    },
    {
     "do": "key",
     "key": "\\",
     "modifiers": [
      "cmd"
     ]
    },
    {
     "do": "wait",
     "seconds": 0.5
    },
    {
     "do": "state",
     "name": "lights-out-clear"
    },
    {
     "do": "expect",
     "that": "app.filter.flags.count",
     "eq": 0,
     "note": "Cmd-backslash still clears the filter at Lights Out 'out'"
    }
   ]
  },
  {
   "name": "keymap-menu-enablement",
