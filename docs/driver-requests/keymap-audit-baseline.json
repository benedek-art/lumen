    {
     "do": "key",
     "key": "b",
     "modifiers": [
      "cmd"
     ]
    },
    {
     "do": "wait",
     "seconds": 0.6
    },
    {
     "do": "expect",
     "that": "menu.View > Assessment Surround (on).enabled",
     "eq": true,
     "note": "the item's title says it is on"
    },
    {
     "do": "state",
     "name": "menus-after"
    }
   ]
