{
  "name": "repro-mask-overlay",
  "description": "Owner report: the red mask overlay never goes away. Wanted (Lightroom): it hides once you adjust the mask and shows only while the pointer is over the mask in the panel. Creates a linear gradient, drags one of its sliders, parks the pointer on the picture and records whether the overlay is still up, then hovers the mask row and leaves again.",
  "fixture": "fiducial",
  "timeoutSeconds": 300,
  "steps": [
    {"do": "open", "photo": "fiducial.png", "workspace": "develop"},
    {"do": "shot", "name": "base"},
    {"do": "key", "key": "m"},
    {"do": "waitFor", "that": "masking", "eq": true, "timeout": 5},
    {"do": "wait", "seconds": 0.6},
    {"do": "state", "name": "masking"},
    {"do": "click", "target": "mask-kind/Linear Gradient"},
    {"do": "wait", "seconds": 0.4},
    {"do": "drag", "id": "place", "target": "viewer", "from": [0.5, 0.25], "to": [0.5, 0.75], "duration": 0.6, "note": "draw the gradient on the picture"},
    {"do": "wait", "seconds": 0.6},
    {"do": "state", "name": "mask-created", "texts": true},
    {"do": "expect", "that": "masks.count", "eq": 1, "note": "a mask exists"},
    {"do": "shot", "name": "created"},
    {"do": "scrollTo", "target": "slider/Exposure#track"},
    {"do": "drag", "id": "adjust", "target": "slider/Exposure#track", "from": [0.5, 0.5], "to": [0.7, 0.5], "duration": 0.8, "settle": 15, "note": "adjust the mask's Exposure"},
    {"do": "move", "target": "viewer", "at": [0.2, 0.5], "duration": 0.3, "note": "park the pointer on the picture, away from the mask panel"},
    {"do": "wait", "seconds": 2.5},
    {"do": "shot", "name": "after-adjust"},
    {"do": "state", "name": "after-adjust"},
    {"do": "compare", "name": "afterAdjust", "a": "base", "b": "after-adjust"},
    {"do": "expect", "that": "masks.overlayShown", "eq": false, "note": "after adjusting, with the pointer away, the overlay is hidden (state)"},
    {"do": "expect", "that": "compare.afterAdjust.redShift", "lt": 2, "note": "after adjusting, with the pointer away, no red tint on the picture (pixels)"},
    {"do": "move", "target": "mask-row", "at": [0.5, 0.5], "duration": 0.3, "note": "hover the mask in the panel"},
    {"do": "wait", "seconds": 1.0},
    {"do": "shot", "name": "hover-row"},
    {"do": "compare", "name": "hoverRow", "a": "base", "b": "hover-row"},
    {"do": "expect", "that": "masks.overlayShown", "eq": true, "note": "hovering the mask row shows the overlay (state)"},
    {"do": "expect", "that": "compare.hoverRow.redShift", "gt": 2, "note": "hovering the mask row shows the overlay (pixels)"},
    {"do": "move", "target": "viewer", "at": [0.2, 0.5], "duration": 0.3},
    {"do": "wait", "seconds": 2.5},
    {"do": "shot", "name": "left-row"},
    {"do": "compare", "name": "leftRow", "a": "base", "b": "left-row"},
    {"do": "expect", "that": "masks.overlayShown", "eq": false, "note": "leaving the row hides it again (state)"},
    {"do": "expect", "that": "compare.leftRow.redShift", "lt": 2, "note": "leaving the row hides it again (pixels)"},
    {"do": "state", "name": "end"}
  ]
}
