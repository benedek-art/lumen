{
  "name": "repro-slider-wb-mixer",
  "description": "The repro-slider-drag shape for two more families: a white balance drag (Temp) and a colour mixer drag (Hue, in the Colour section), 1.5 s at 60 Hz on the 33 MP A7 IV ARW, each once timed and once filmed.",
  "fixture": "raw",
  "timeoutSeconds": 600,
  "steps": [
    {"do": "open", "photo": "A7IV", "workspace": "develop", "timeout": 90},
    {"do": "expect", "that": "render.nativeLongEdge", "gt": 6000, "note": "the 33 MP file decoded"},
    {"do": "scrollTo", "target": "slider/Temp#track"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "drag", "id": "temp", "target": "slider/Temp#track", "from": [0.5, 0.5], "to": [0.7, 0.5], "duration": 1.5, "hz": 60, "settle": 30, "watch": "develop.raw.temp", "note": "Temp: 1.5 s drag at 60 Hz, timing only"},
    {"do": "expect", "that": "steps.temp.framesDuring", "ge": 20, "note": "Temp: the picture updates during the drag (at least 20 frames)"},
    {"do": "expect", "that": "steps.temp.maxFrameGapMs", "lt": 250, "note": "Temp: never more than 250 ms without a new frame while dragging"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "drag", "id": "temp-filmed", "target": "slider/Temp#track", "from": [0.7, 0.5], "to": [0.5, 0.5], "duration": 1.5, "hz": 60, "settle": 30, "film": 30, "watch": "develop.raw.temp", "note": "Temp: the same drag back, with the screen watched at 30 Hz"},
    {"do": "expect", "that": "steps.temp-filmed.screenChangesDuring", "ge": 15, "note": "Temp: the screen itself changes at least 15 times during the drag"},
    {"do": "shot", "name": "after-temp"},
    {"do": "scroll", "target": "develop.column", "lines": [0, -12], "count": 8, "interval": 0.05},
    {"do": "wait", "seconds": 0.5},
    {"do": "click", "target": {"text": "Colour", "within": "develop.column"}, "note": "open the Colour section"},
    {"do": "wait", "seconds": 1},
    {"do": "state", "name": "colour-open"},
    {"do": "scrollTo", "target": "slider/Hue#track"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "drag", "id": "hue", "target": "slider/Hue#track", "from": [0.5, 0.5], "to": [0.75, 0.5], "duration": 1.5, "hz": 60, "settle": 30, "note": "Colour mixer Hue: 1.5 s drag at 60 Hz, timing only"},
    {"do": "expect", "that": "steps.hue.framesDuring", "ge": 20, "note": "Hue: the picture updates during the drag (at least 20 frames)"},
    {"do": "expect", "that": "steps.hue.maxFrameGapMs", "lt": 250, "note": "Hue: never more than 250 ms without a new frame while dragging"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "drag", "id": "hue-filmed", "target": "slider/Hue#track", "from": [0.75, 0.5], "to": [0.5, 0.5], "duration": 1.5, "hz": 60, "settle": 30, "film": 30, "note": "Hue: the same drag back, with the screen watched at 30 Hz"},
    {"do": "expect", "that": "steps.hue-filmed.screenChangesDuring", "ge": 15, "note": "Hue: the screen itself changes at least 15 times during the drag"},
    {"do": "shot", "name": "after-hue"},
    {"do": "state", "name": "end"}
  ]
}
