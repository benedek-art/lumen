{
  "name": "names-buttons",
  "description": "Five named non-slider buttons in different panels, and list-targets on Develop and Library.",
  "fixture": "fiducial",
  "timeoutSeconds": 240,
  "stallSampleMs": 0,
  "steps": [
    {"do": "open", "photo": "fiducial.png", "workspace": "develop"},
    {"do": "listTargets", "name": "develop"},
    {"do": "click", "id": "rail-grade", "target": "rail/Grade"},
    {"do": "expect", "that": "workspace", "eq": "grade", "note": "rail button by name"},
    {"do": "click", "target": "rail/Develop"},
    {"do": "expect", "that": "workspace", "eq": "develop"},
    {"do": "shot", "name": "01-develop"},
    {"do": "click", "id": "source-picked", "target": "source/Picked"},
    {"do": "wait", "seconds": 0.4},
    {"do": "shot", "name": "02-picked"},
    {"do": "click", "target": "source/All photos"},
    {"do": "click", "id": "rail-deliver", "target": "rail/Deliver"},
    {"do": "listTargets", "name": "deliver"},
    {"do": "scrollTo", "target": "button/Open Export…"},
    {"do": "click", "id": "open-export", "target": "button/Open Export…"},
    {"do": "waitFor", "that": "windows.sheet", "eq": true, "timeout": 5, "note": "Deliver's Open Export… button by name"},
    {"do": "key", "key": "escape"},
    {"do": "waitFor", "that": "windows.sheet", "eq": false, "timeout": 5},
    {"do": "click", "id": "rail-crop", "target": "rail/Crop"},
    {"do": "listTargets", "name": "crop"},
    {"do": "click", "id": "unlock", "target": "button/Unlock", "note": "the crop panel's aspect lock"},
    {"do": "wait", "seconds": 0.5},
    {"do": "shot", "name": "03-crop-custom"},
    {"do": "state", "name": "crop-custom"},
    {"do": "key", "key": "escape"},
    {"do": "click", "target": "rail/Develop"},
    {"do": "click", "id": "filter", "target": {"name": "*/Filter", "within": "filterbar"}},
    {"do": "wait", "seconds": 0.5},
    {"do": "shot", "name": "04-filter"},
    {"do": "listTargets", "name": "filter-popover"},
    {"do": "key", "key": "escape"},
    {"do": "key", "key": "g", "note": "Library: the grid"},
    {"do": "wait", "seconds": 0.6},
    {"do": "listTargets", "name": "library"},
    {"do": "shot", "name": "05-library"},
    {"do": "state", "name": "end", "ax": true},
    {"do": "click", "id": "menubar-view", "target": "menubar/View", "via": "hid", "note": "last: a menu's tracking loop is the riskiest thing here"},
    {"do": "wait", "seconds": 0.5},
    {"do": "shot", "name": "06-view-menu"},
    {"do": "listTargets", "name": "view-menu"},
    {"do": "key", "key": "escape"}
  ]
}
