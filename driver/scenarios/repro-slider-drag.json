{
  "name": "repro-slider-drag",
  "description": "Owner report: the picture usually does not update until a slider drag ends. Drags Exposure, Saturation and Texture for 1.5 s at 60 Hz on the 33 MP A7 IV ARW and counts the frames delivered during each drag, the longest gap, input-to-frame latency and the time from release to the sharp frame.",
  "fixture": "raw",
  "timeoutSeconds": 600,
  "steps": [
    {"do": "open", "photo": "A7IV", "workspace": "develop", "timeout": 90},
    {"do": "shot", "name": "open"},
    {"do": "state", "name": "open"},
    {"do": "expect", "that": "render.nativeLongEdge", "gt": 6000, "note": "the 33 MP file decoded"},
    {"do": "scrollTo", "target": "slider/Exposure#track"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "drag", "id": "exposure", "target": "slider/Exposure#track", "from": [0.5, 0.5], "to": [0.72, 0.5], "duration": 1.5, "hz": 60, "settle": 30, "watch": "develop.tone.exposure", "note": "Exposure: 1.5 s drag at 60 Hz"},
    {"do": "expect", "that": "steps.exposure.framesDuring", "ge": 20, "note": "Exposure: the picture updates during the drag (at least 20 frames in 1.5 s)"},
    {"do": "expect", "that": "steps.exposure.maxFrameGapMs", "lt": 250, "note": "Exposure: never more than 250 ms without a new frame while dragging"},
    {"do": "expect", "that": "steps.exposure.latencyMs.p50", "lt": 100, "note": "Exposure: median input-to-frame latency under 100 ms"},
    {"do": "expect", "that": "steps.exposure.releaseToSettledMs", "lt": 1500, "note": "Exposure: sharp within 1.5 s of release"},
    {"do": "shot", "name": "after-exposure"},
    {"do": "scrollTo", "target": "slider/Saturation#track"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "drag", "id": "saturation", "target": "slider/Saturation#track", "from": [0.5, 0.5], "to": [0.8, 0.5], "duration": 1.5, "hz": 60, "settle": 30, "watch": "develop.color.saturation", "note": "Saturation: 1.5 s drag at 60 Hz"},
    {"do": "expect", "that": "steps.saturation.framesDuring", "ge": 20, "note": "Saturation: the picture updates during the drag (at least 20 frames in 1.5 s)"},
    {"do": "expect", "that": "steps.saturation.maxFrameGapMs", "lt": 250, "note": "Saturation: never more than 250 ms without a new frame while dragging"},
    {"do": "expect", "that": "steps.saturation.latencyMs.p50", "lt": 100, "note": "Saturation: median input-to-frame latency under 100 ms"},
    {"do": "expect", "that": "steps.saturation.releaseToSettledMs", "lt": 1500, "note": "Saturation: sharp within 1.5 s of release"},
    {"do": "shot", "name": "after-saturation"},
    {"do": "scrollTo", "target": "slider/Texture#track"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "drag", "id": "texture", "target": "slider/Texture#track", "from": [0.5, 0.5], "to": [0.85, 0.5], "duration": 1.5, "hz": 60, "settle": 30, "watch": "develop.detail.texture", "note": "Texture: 1.5 s drag at 60 Hz"},
    {"do": "expect", "that": "steps.texture.framesDuring", "ge": 20, "note": "Texture: the picture updates during the drag (at least 20 frames in 1.5 s)"},
    {"do": "expect", "that": "steps.texture.maxFrameGapMs", "lt": 250, "note": "Texture: never more than 250 ms without a new frame while dragging"},
    {"do": "expect", "that": "steps.texture.latencyMs.p50", "lt": 100, "note": "Texture: median input-to-frame latency under 100 ms"},
    {"do": "expect", "that": "steps.texture.releaseToSettledMs", "lt": 1500, "note": "Texture: sharp within 1.5 s of release"},
    {"do": "shot", "name": "after-texture"},
    {"do": "state", "name": "end"}
  ]
}
