{
  "name": "probe",
  "description": "Reports what works on this machine (permissions, display modes, capture methods: read probe.json) and checks, for each input backend, that every kind of event has its effect in the app. The table in driver/README.md is this scenario's result.",
  "fixture": "fiducial",
  "timeoutSeconds": 360,
  "steps": [
    {"do": "open", "photo": "fiducial.png", "workspace": "develop"},
    {"do": "probe"},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 30, "quiet": 0.8},
    {"do": "move", "via": "hid", "target": "viewer", "at": [0, 0], "offset": [111, 77]},
    {"do": "wait", "seconds": 0.3},
    {"do": "expect", "that": "viewport.lastCursorX", "near": 111, "tol": 1.5, "note": "hid: a mouse move reaches the viewer's hover at the right place"},
    {"do": "expect", "that": "viewport.lastCursorY", "near": 77, "tol": 1.5, "note": "hid: hover y"},
    {"do": "scroll", "id": "wheel-hid", "via": "hid", "target": "viewer", "at": [0.4, 0.4], "lines": [0, 1], "count": 2},
    {"do": "expect", "that": "viewport.zoom", "gt": 0, "note": "hid: a wheel event zooms the viewer"},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 30, "quiet": 0.8},
    {"do": "pinch", "id": "pinch-hid", "via": "hid", "target": "viewer", "at": [0.4, 0.4], "scale": 1.5, "duration": 0.3},
    {"do": "expect", "that": "viewport.zoom", "gt": 0, "note": "hid: a pinch reaches MagnifyGesture"},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 30, "quiet": 0.8},
    {"do": "click", "id": "dbl-hid", "via": "hid", "target": "viewer", "at": [0.5, 0.5], "count": 2},
    {"do": "waitFor", "that": "viewport.zoom", "eq": 1, "timeout": 3, "note": "hid: a double-click goes to 1:1"},
    {"do": "drag", "id": "drag-hid", "via": "hid", "target": "viewer", "from": [0.5, 0.5], "to": [0.42, 0.44], "duration": 0.3},
    {"do": "expect", "that": "viewport.panX", "lt": -20, "note": "hid: a drag pans the zoomed picture"},
    {"do": "state", "name": "before-swipe-hid"},
    {"do": "swipe", "id": "swipe-hid", "via": "hid", "target": "viewer", "at": [0.5, 0.5], "by": [40, 30], "duration": 0.25},
    {"do": "expect", "that": "viewport.panY", "gt": -25, "note": "hid: a two-finger scroll pans the zoomed picture"},
    {"do": "smartMagnify", "id": "smart-hid", "via": "hid", "target": "viewer", "at": [0.5, 0.5]},
    {"do": "click", "id": "right-hid", "via": "hid", "target": "viewer", "at": [0.5, 0.5], "button": "right"},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 30, "quiet": 0.8},
    {"do": "key", "id": "key-hid", "via": "hid", "key": "g"},
    {"do": "waitFor", "that": "viewMode", "eq": "grid", "timeout": 3, "note": "hid: the bare key G shows the grid"},
    {"do": "key", "via": "hid", "key": "e"},
    {"do": "waitFor", "that": "viewMode", "eq": "loupe", "timeout": 3, "note": "hid: the bare key E shows the loupe"},
    {"do": "key", "id": "chord-hid", "via": "hid", "key": "4", "modifiers": ["cmd"]},
    {"do": "waitFor", "that": "workspace", "eq": "grade", "timeout": 3, "note": "hid: the chord cmd-4 enters Grade"},
    {"do": "key", "via": "hid", "key": "2", "modifiers": ["cmd"]},
    {"do": "waitFor", "that": "workspace", "eq": "develop", "timeout": 3, "note": "hid: cmd-2 returns to Develop"},
    {"do": "waitSettled", "timeout": 20},
    {"do": "scrollTo", "via": "hid", "target": "slider/Exposure#track"},
    {"do": "drag", "id": "slider-hid", "via": "hid", "target": "slider/Exposure#track", "from": [0.5, 0.5], "to": [0.65, 0.5], "duration": 0.5, "settle": 15},
    {"do": "expect", "that": "recipe.develop.tone.exposure", "gt": 0.1, "note": "hid: dragging a slider track changes the setting"},
    {"do": "click", "via": "hid", "target": "slider/Exposure", "at": [0.08, 0.5], "count": 2},
    {"do": "waitFor", "that": "recipe.develop.tone.exposure", "exists": false, "timeout": 3, "note": "hid: double-clicking a slider's label resets it"},
    {"do": "move", "via": "hid", "target": "viewer", "at": [0.3, 0.3]},
    {"do": "waitSettled", "timeout": 20},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 30, "quiet": 0.8},
    {"do": "move", "via": "app", "target": "viewer", "at": [0, 0], "offset": [222, 77]},
    {"do": "wait", "seconds": 0.3},
    {"do": "expect", "that": "viewport.lastCursorX", "near": 222, "tol": 1.5, "note": "app: a mouse move reaches the viewer's hover at the right place"},
    {"do": "expect", "that": "viewport.lastCursorY", "near": 77, "tol": 1.5, "note": "app: hover y"},
    {"do": "scroll", "id": "wheel-app", "via": "app", "target": "viewer", "at": [0.4, 0.4], "lines": [0, 1], "count": 2},
    {"do": "expect", "that": "viewport.zoom", "gt": 0, "note": "app: a wheel event zooms the viewer"},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 30, "quiet": 0.8},
    {"do": "pinch", "id": "pinch-app", "via": "app", "target": "viewer", "at": [0.4, 0.4], "scale": 1.5, "duration": 0.3},
    {"do": "expect", "that": "viewport.zoom", "gt": 0, "note": "app: a pinch reaches MagnifyGesture"},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 30, "quiet": 0.8},
    {"do": "click", "id": "dbl-app", "via": "app", "target": "viewer", "at": [0.5, 0.5], "count": 2},
    {"do": "waitFor", "that": "viewport.zoom", "eq": 1, "timeout": 3, "note": "app: a double-click goes to 1:1"},
    {"do": "drag", "id": "drag-app", "via": "app", "target": "viewer", "from": [0.5, 0.5], "to": [0.42, 0.44], "duration": 0.3},
    {"do": "expect", "that": "viewport.panX", "lt": -20, "note": "app: a drag pans the zoomed picture"},
    {"do": "state", "name": "before-swipe-app"},
    {"do": "swipe", "id": "swipe-app", "via": "app", "target": "viewer", "at": [0.5, 0.5], "by": [40, 30], "duration": 0.25},
    {"do": "expect", "that": "viewport.panY", "gt": -25, "note": "app: a two-finger scroll pans the zoomed picture"},
    {"do": "smartMagnify", "id": "smart-app", "via": "app", "target": "viewer", "at": [0.5, 0.5]},
    {"do": "click", "id": "right-app", "via": "app", "target": "viewer", "at": [0.5, 0.5], "button": "right"},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 30, "quiet": 0.8},
    {"do": "key", "id": "key-app", "via": "app", "key": "g"},
    {"do": "waitFor", "that": "viewMode", "eq": "grid", "timeout": 3, "note": "app: the bare key G shows the grid"},
    {"do": "key", "via": "app", "key": "e"},
    {"do": "waitFor", "that": "viewMode", "eq": "loupe", "timeout": 3, "note": "app: the bare key E shows the loupe"},
    {"do": "key", "id": "chord-app", "via": "app", "key": "4", "modifiers": ["cmd"]},
    {"do": "waitFor", "that": "workspace", "eq": "grade", "timeout": 3, "note": "app: the chord cmd-4 enters Grade"},
    {"do": "key", "via": "app", "key": "2", "modifiers": ["cmd"]},
    {"do": "waitFor", "that": "workspace", "eq": "develop", "timeout": 3, "note": "app: cmd-2 returns to Develop"},
    {"do": "waitSettled", "timeout": 20},
    {"do": "scrollTo", "via": "app", "target": "slider/Exposure#track"},
    {"do": "drag", "id": "slider-app", "via": "app", "target": "slider/Exposure#track", "from": [0.5, 0.5], "to": [0.65, 0.5], "duration": 0.5, "settle": 15},
    {"do": "expect", "that": "recipe.develop.tone.exposure", "gt": 0.1, "note": "app: dragging a slider track changes the setting"},
    {"do": "click", "via": "app", "target": "slider/Exposure", "at": [0.08, 0.5], "count": 2},
    {"do": "waitFor", "that": "recipe.develop.tone.exposure", "exists": false, "timeout": 3, "note": "app: double-clicking a slider's label resets it"},
    {"do": "move", "via": "app", "target": "viewer", "at": [0.3, 0.3]},
    {"do": "waitSettled", "timeout": 20},
    {"do": "state", "name": "probe", "texts": true}
  ]
}
