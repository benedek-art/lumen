{
  "name": "repro-pinch-zoom",
  "description": "Owner report: trackpad zoom and pan are broken. Pinches on the fiducial with a screenshot after every few events, so the pixel witness can say how far the image point under the cursor drifts, whether a second pinch compounds, how a two-finger pan moves the picture, and how far it can be pushed past its borders.",
  "fixture": "fiducial",
  "via": "hid",
  "timeoutSeconds": 420,
  "steps": [
    {"do": "open", "photo": "fiducial.png", "workspace": "develop"},
    {"do": "move", "target": "viewer", "at": [0.35, 0.4], "duration": 0.2},
    {"do": "shot", "name": "fit"},
    {"do": "pinch", "id": "pinch1", "target": "viewer", "at": [0.35, 0.4], "scale": 2.0, "duration": 0.6, "hz": 60, "capture": 4, "note": "2x pinch, captured every 4th event"},
    {"do": "shot", "name": "pinch1-end"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "shot", "name": "pinch1-settled", "also": "cacheDisplay"},
    {"do": "expect", "that": "shots.pinch1-settled.lumaSD", "gt": 10, "note": "after the pinch settles there is a picture on screen, not a blank"},
    {"do": "state", "name": "after-pinch1"},
    {"do": "expect", "that": "viewport.zoom", "gt": 0, "note": "the pinch left fit"},
    {"do": "pinch", "id": "pinch2", "target": "viewer", "at": [0.35, 0.4], "scale": 1.5, "duration": 0.5, "hz": 60, "capture": 4, "note": "a second pinch must continue from the first"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "shot", "name": "pinch2-settled"},
    {"do": "state", "name": "after-pinch2"},
    {"do": "swipe", "id": "pan", "target": "viewer", "at": [0.5, 0.5], "by": [-150, -90], "duration": 0.5, "hz": 60, "capture": 6, "note": "two-finger pan while zoomed"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "shot", "name": "pan-settled"},
    {"do": "swipe", "id": "overpan", "target": "viewer", "at": [0.5, 0.5], "by": [6000, 4000], "duration": 0.8, "hz": 60, "note": "push the picture far past its top-left corner"},
    {"do": "wait", "seconds": 0.5},
    {"do": "shot", "name": "overpan"},
    {"do": "state", "name": "overpan"},
    {"do": "expect", "that": "viewport.insetLeft", "gt": 40, "note": "owner wants free pan past the edges (app's own geometry)"},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 30},
    {"do": "move", "target": "viewer", "at": [0.6, 0.55]},
    {"do": "pinch", "id": "pinch-live", "target": "viewer", "at": [0.6, 0.55], "scale": 2.0, "duration": 0.6, "hz": 60, "settle": 30, "film": 30, "note": "the same pinch at real speed, for timing"},
    {"do": "expect", "that": "steps.pinch-live.hitchMaxMs", "lt": 100, "note": "the main thread never stalls longer than 100 ms during a pinch"},
    {"do": "expect", "that": "steps.pinch-live.gestureMs", "lt": 1200, "note": "a 0.6 s pinch is over within 1.2 s"},
    {"do": "expect", "that": "steps.pinch-live.hitchAfterMaxMs", "lt": 250, "note": "after the pinch the app answers again within a quarter second"},
    {"do": "expect", "that": "steps.pinch-live.screenChangesDuring", "ge": 15, "note": "the picture visibly follows the pinch (30 Hz watch of the screen)"},
    {"do": "shot", "name": "pinch-live-settled"}
  ],
  "witness": [
    {"that": "groups.pinch1.driftMaxPt", "lt": 2, "note": "the image point under the cursor stays under it during the pinch"},
    {"that": "groups.pinch1.jumpMaxPt", "lt": 4, "note": "no jump between consecutive frames of the pinch"},
    {"that": "groups.pinch1.scaleRatio", "near": 2.0, "tol": 0.15, "note": "a 2x pinch doubles what is on screen"},
    {"that": "drift.pinch1-000.pinch1-settled", "lt": 2, "note": "still anchored once the sharp render lands"},
    {"that": "groups.pinch2.scaleRatio", "near": 1.5, "tol": 0.12, "note": "the second pinch compounds from where the first ended"},
    {"that": "groups.pinch2.driftMaxPt", "lt": 2},
    {"that": "groups.pan.moveX", "near": -150, "tol": 6, "note": "a two-finger pan moves the picture by the fingers' distance"},
    {"that": "groups.pan.moveY", "near": -90, "tol": 6},
    {"that": "shots.overpan.insetLeft", "gt": 40, "note": "owner wants free pan past the edges (pixels)"},
    {"that": "shots.pinch1-settled.claimErrorPt", "lt": 2, "note": "the app's own idea of the image rectangle matches the pixels"}
  ]
}
