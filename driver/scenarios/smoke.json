{
  "name": "smoke",
  "description": "Opens the fiducial in Develop and uses every verb once. The lane's own health check.",
  "fixture": "fiducial",
  "timeoutSeconds": 240,
  "steps": [
    {"do": "open", "photo": "fiducial.png", "workspace": "develop"},
    {"do": "shot", "name": "01-develop-fit"},
    {"do": "state", "name": "open"},
    {"do": "expect", "that": "viewMode", "eq": "loupe"},
    {"do": "expect", "that": "photo.name", "eq": "fiducial.png"},
    {"do": "expect", "that": "viewport.zoom", "eq": 0},
    {"do": "expect", "that": "render.draft", "eq": false},

    {"do": "move", "target": "viewer", "at": [0.3, 0.4], "duration": 0.2},
    {"do": "wait", "seconds": 0.2},
    {"do": "expect", "that": "viewport.lastCursorX", "gt": 1, "note": "hover reaches the viewer"},

    {"do": "pinch", "id": "pinch", "target": "viewer", "at": [0.3, 0.4], "scale": 2.0, "duration": 0.5},
    {"do": "expect", "that": "viewport.zoom", "gt": 0, "note": "a pinch zooms"},
    {"do": "waitSettled", "timeout": 15},
    {"do": "shot", "name": "02-after-pinch"},

    {"do": "swipe", "id": "swipe", "target": "viewer", "at": [0.5, 0.5], "by": [-120, -60], "duration": 0.3,
     "momentum": {"by": [-60, -30], "duration": 0.4}},
    {"do": "shot", "name": "03-after-swipe"},

    {"do": "scroll", "id": "wheel", "target": "viewer", "at": [0.5, 0.5], "lines": [0, -1], "count": 3},
    {"do": "shot", "name": "04-after-wheel"},

    {"do": "direct", "call": "fit"},
    {"do": "click", "id": "doubleclick", "target": "viewer", "at": [0.6, 0.5], "count": 2},
    {"do": "wait", "seconds": 0.3},
    {"do": "expect", "that": "viewport.zoom", "eq": 1, "note": "double-click goes to 1:1"},
    {"do": "drag", "id": "pan", "target": "viewer", "from": [0.5, 0.5], "to": [0.4, 0.45], "duration": 0.4},
    {"do": "shot", "name": "05-one-to-one-panned"},
    {"do": "smartMagnify", "target": "viewer"},
    {"do": "key", "key": "-", "modifiers": ["cmd"]},
    {"do": "direct", "call": "fit"},
    {"do": "waitSettled", "timeout": 15},

    {"do": "drag", "id": "exposure", "target": "slider/Exposure#track", "from": [0.5, 0.5], "to": [0.7, 0.5],
     "duration": 0.8, "hz": 60, "settle": 15, "watch": "develop.tone.exposure"},
    {"do": "expect", "that": "recipe.develop.tone.exposure", "gt": 0.1, "note": "dragging Exposure changes it"},
    {"do": "shot", "name": "06-after-exposure"},
    {"do": "compare", "name": "exposure", "a": "01-develop-fit", "b": "06-after-exposure"},
    {"do": "expect", "that": "compare.exposure.meanAbs", "gt": 2, "note": "the picture got brighter on screen"},

    {"do": "click", "target": "viewer", "at": [0.5, 0.5], "button": "right"},
    {"do": "key", "key": "escape"},
    {"do": "key", "key": "m"},
    {"do": "wait", "seconds": 0.5},
    {"do": "expect", "that": "masking", "eq": true, "note": "M enters masking"},
    {"do": "shot", "name": "07-masking"},
    {"do": "probe"},
    {"do": "state", "name": "end"}
  ]
}
